{
  "name": "explain-abbreviation",
  "version": "0.0.1",
  "description": "Uitleg bij een afkorting, als webcomponent gebouwd met Stencil",
  "author": "Timo Smit",
  "license": "MIT",
  "main": "dist/index.cjs.js",
  "module": "dist/index.js",
  "types": "dist/types/index.d.ts",
  "collection": "dist/collection/collection-manifest.json",
  "collection:main": "dist/collection/index.js",
  "unpkg": "dist/explain-abbreviation/explain-abbreviation.esm.js",
  "exports": {
    ".": {
      "import": "./dist/explain-abbreviation/explain-abbreviation.esm.js",
      "require": "./dist/explain-abbreviation/explain-abbreviation.cjs.js"
    },
    "./explain-abbreviation": {
      "import": "./dist/components/explain-abbreviation.js",
      "types": "./dist/components/explain-abbreviation.d.ts"
    },
    "./loader": {
      "import": "./loader/index.js",
      "require": "./loader/index.cjs",
      "types": "./loader/index.d.ts"
    }
  },
  "files": [
    "dist/",
    "loader/"
  ],
  "scripts": {
    "build": "stencil build",
    "start": "stencil build --dev --watch --serve",
    "test": "stencil-test --prod",
    "test:watch": "stencil-test --prod --watch",
    "generate": "stencil generate",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@stencil/core": "^4.45.2",
    "@stencil/vitest": "^1.8.3",
    "@types/node": "^22.13.5",
    "@vitest/browser-playwright": "^4.0.0",
    "axe-core": "^4.14.0",
    "playwright": "~1.64.0",
    "prettier": "^3.9.10",
    "vitest": "^4.0.0"
  }
}
